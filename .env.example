# Root environment file for docker-compose.
# Copy to ".env" and adjust before running `docker compose up`.

# --- Secrets (REQUIRED in production) ---
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_RESET_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d

# --- Public URLs ---
# CLIENT_URL is where the SPA is served (used for email links + verification QR codes).
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:5000

# --- File handling ---
MAX_FILE_SIZE_MB=15

# --- Email (optional). Leave SMTP_HOST blank to log reset links to the server console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digital Signature <no-reply@digisign.local>

# --- Demo accounts created by `npm run seed` / `docker compose exec server npm run seed` ---
SEED_ADMIN_EMAIL=admin@digisign.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@digisign.local
SEED_USER_PASSWORD=Demo@12345
