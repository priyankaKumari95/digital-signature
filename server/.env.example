# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local: mongodb://127.0.0.1:27017/digital_signature
# Docker compose uses the service name "mongo"
MONGO_URI=mongodb://127.0.0.1:27017/digital_signature

# ---- Auth / JWT ----
# Generate strong values for production, e.g. `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-to-another-long-random-string
JWT_RESET_EXPIRES_IN=30m
BCRYPT_ROUNDS=12

# ---- Public URLs (used for CORS, email links, QR codes) ----
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ---- File handling ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30

# ---- Email (password recovery). Leave blank to log reset links to console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digital Signature <no-reply@digisign.local>

# ---- Seed (demo accounts created by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@digisign.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@digisign.local
SEED_USER_PASSWORD=Demo@12345
